# ============================================================
# Pikyon backend: environment template
# Copy to backend/.env and fill in real values. NEVER commit .env
# ============================================================

# --- Application ---
APP_ENV=development
PORT=8080
LOG_LEVEL=debug
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (Supabase Postgres, via pgx) ---
# Use the SESSION POOLER string (port 5432). The direct connection
# is IPv6-only and fails on IPv4 networks and GitHub runners.
# If the password has special characters, URL-encode them (@ = %40).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_DB_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require
APP_DATABASE_URL=postgresql://pikyon_app.<project-ref>:<the-new-password>@<same-pooler-host>:5432/postgres?sslmode=require
# Keep these two numbers' sum within your Supabase session-pooler pool size
# (Dashboard > Project Settings > Database > Connection pooling).
DB_APP_MAX_CONNS=8
DB_ADMIN_MAX_CONNS=4
# --- Supabase Storage ---
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=<secret-or-service-role-key>
SUPABASE_BUCKET=dev-memories

# --- Auth ---
JWT_SECRET=<generate: openssl rand -hex 64>
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=168h
ROTATION_GRACE_PERIOD=30s
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# --- AI ---
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<free-tier-model-name-from-ai-studio>

# --- Email ---
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM=<verified-sender-address>

# --- Sprint 5 only (2FA). Keep commented until then. ---
# TOTP_ENCRYPTION_KEY=<generate: openssl rand -hex 32>